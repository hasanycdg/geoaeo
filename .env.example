# Copy to .env and fill in. Shopify vars are injected by `shopify app dev`.

# Infrastructure
DATABASE_URL="postgresql://geo:geo@localhost:5432/geo_monitor?schema=public"
REDIS_URL="redis://localhost:6379"

# GEO API service (apps/api)
PORT="3000"
# Shared secret the Shopify app uses to call the API as a trusted first party.
INTERNAL_API_SECRET="change-me-long-random"

# LLM provider API keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
PERPLEXITY_API_KEY=""

# --- Shopify (billing via Admin GraphQL AppSubscription) ---
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""       # also verifies Shopify billing webhooks
SHOPIFY_API_VERSION="2025-01"
SHOPIFY_BILLING_TEST="true" # use test charges in dev

# --- Stripe (billing for WordPress tenants) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""     # from `stripe listen` or the dashboard
STRIPE_PRICE_STARTER=""      # price_… ids for each paid plan
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
