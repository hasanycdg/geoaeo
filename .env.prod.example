# Production env for docker-compose.prod.yml (backend-only).
# Copy to .env ON THE SERVER and fill in. NEVER commit the real .env.

# --- Public domain (Caddy TLS) ---
# The subdomain whose DNS A-record points at this server. Caddy gets a
# Let's Encrypt cert for it automatically. This matches the WP plugin's default
# backend URL (https://api.getbrandradar.com), so the plugin needs no override.
API_DOMAIN="api.getbrandradar.com"

# --- Postgres (compose service) ---
POSTGRES_USER="geo"
POSTGRES_PASSWORD="CHANGE-ME-long-random"
POSTGRES_DB="geo_monitor"

# --- Connection strings (point at the compose service names, not localhost) ---
DATABASE_URL="postgresql://geo:CHANGE-ME-long-random@postgres:5432/geo_monitor?schema=public"
REDIS_URL="redis://redis:6379"

PORT="3000"

# Host port the api-web container binds to on 127.0.0.1 (behind the reverse
# proxy). Change only if this port clashes with another app on the host; keep
# deploy/nginx-api.conf's proxy_pass in sync.
API_HOST_PORT="8770"

# Host port the embedded Shopify app (web) binds to on 127.0.0.1. Keep
# deploy/nginx-app.conf's proxy_pass in sync.
WEB_HOST_PORT="8780"

# --- Shared secret between the Shopify app and this API (trusted first party) ---
INTERNAL_API_SECRET="CHANGE-ME-long-random"

# --- LLM provider API keys (without them, providers return mock answers) ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
PERPLEXITY_API_KEY=""

# --- Shopify (embedded app + billing via Admin GraphQL AppSubscription) ---
# From the Partner Dashboard → your app → API credentials.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_API_VERSION="2025-01"
SHOPIFY_BILLING_TEST="false"
# Public URL of the embedded app (matches application_url in shopify.app.toml).
SHOPIFY_APP_URL="https://app.getbrandradar.com"

# --- Stripe (billing for WordPress tenants) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
